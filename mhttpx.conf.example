-- mhttpx configuration. The file is Lua and returns a table.
-- Check it with: mhttpx -n -f /etc/mhttpx.lua
-- Reload it with SIGHUP; the worker reads the TLS files again then.

local app = "http://10.0.0.2:8080"
local isolate = {
	["Cross-Origin-Opener-Policy"] = "same-origin",
	["Cross-Origin-Embedder-Policy"] = "require-corp",
}

return {
	user = "_mhttpx",          -- the worker drops to this user
	-- Where request lines go: "-" for stdout, "syslog", or a file. The
	-- worker opens the file for each line as its user, so give it a
	-- directory it owns, and let newsyslog rotate the file:
	--   /var/log/mhttpx/access.log _mhttpx:_mhttpx 640 7 * $D0 Z
	access_log = "/var/log/mhttpx/access.log",
	-- log = true, on the top, on a site or on a path: true for
	-- access_log, false for none, a destination, or function(e) that
	-- returns a line. e has time, client, host, method, target, path,
	-- version, status, bytes, duration, site, request and response.
	-- Behind another proxy, take the client from X-Forwarded-For when
	-- the peer is one of these ("unix" for a unix socket), or true:
	-- trust_forwarded = { "unix", "192.168.0.1" },
	drain = 10,                -- seconds an old worker may finish requests
	-- pledge = false,         -- OpenBSD: no pledge or unveil
	-- The worker pledges and unveils what the actions need. A handler
	-- that opens files needs more:
	-- promises = "wpath cpath flock",
	-- unveil = { ["/var/db/app"] = "rwc" },

	listen = {
		http = { "0.0.0.0:80", "[::]:80" },
		https = { "0.0.0.0:443", "[::]:443" },
		-- Prometheus metrics at /metrics. Bind it where only the
		-- scraper can reach it.
		metrics = "127.0.0.1:9180",
	},
	-- A second mhttpx can run the apps as another user, behind this one:
	--   listen = { http = { "unix:/var/www/run/apps.sock", group = "_mhttpx" } }
	-- The socket file is 0660 and owned by its user unless the entry
	-- gives mode, owner or group. This one proxies to it with
	--   proxy = "unix:/var/www/run/apps.sock"
	-- A name means the acme-client files /etc/ssl/NAME.crt and
	-- /etc/ssl/private/NAME.key. A pair gives the paths. SNI picks one.
	certs = { "example.org", { "/etc/ssl/other.crt", "/etc/ssl/private/other.key" } },
	-- On http, /.well-known/acme-challenge/ of each host: a directory,
	-- or a URL to proxy to.
	acme = "/var/www/acme",
	-- A request for no site: a URL to proxy to, a status, or a site.
	default = 421,

	-- Exact hosts win over "*." wildcards. On http, a site redirects to
	-- https; http = "serve" serves it on both, https = false on http only.
	sites = {
		{ host = { "example.org", "www.example.org" },
			static = "/var/www/htdocs",
			-- The most specific path with an action answers. Headers
			-- add up from the least to the most specific path.
			["/app/*"] = { headers = isolate },
			["/app/*.wasm"] = { headers = { ["Content-Type"] = "application/wasm" } },
			["/api/*"] = { proxy = app },
			["/cgi-bin/*"] = { cgi = "/var/www/cgi-bin", strip = true },
			["/old"] = { redirect = "https://{host}/new" },
			["/health"] = { status = 200, body = "ok\n", log = false },
		},
		{ host = "mirror.example.org", static = { root = "/var/www/mirror", list = true } },
		{ host = "*.example.org", status = 404, body = "no such site\n" },
		{ host = "status.example.org", https = false, proxy = "http://127.0.0.1:8080" },
		-- http over a unix socket.
		{ host = "app.example.org", proxy = "unix:/var/www/run/app.sock" },
		-- A handler(req, res) in the worker. A module name loads the
		-- module as root; it returns a handler, or a table whose
		-- new(env) returns one. env.metrics takes its own metrics.
		-- A slow handler stalls the worker.
		{ host = "hello.example.org", handler = function(req, res)
			return res:send(200, "hello from " .. req.path .. "\n")
		end },
		{ host = "paste.example.org", handler = "myapp.http" },
		-- A table gives the module env.config.
		{ host = "notes.example.org", handler = { module = "myapp.notes", db = "/var/db/notes" } },
	},
}
